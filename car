#!/usr/bin/env bash
#
# Compile and run a project
#
# Dependencies:
#   - gcc
#
# Author: Jesse Mirabel <sejjymvm@gmail.com>
# Date:   September 08, 2026

DIRNAME="c-projects"

fatal() {
	local script=${0##*/}

	echo "$script: $*" >&2
	exit 1
}

main() {
	if (($# != 2)); then
		fatal "<chapter> <project>"
	fi

	local c=$((10#$1))
	local p=$((10#$2))

	if ((c < 2 || c > 27)); then
		fatal "chapter must be 02 to 27"
	fi

	if ((p < 1 || p > 19)); then
		fatal "project must be 01 to 19"
	fi

	printf -v c "%02d" "$c"
	printf -v p "%02d" "$p"

	case $PWD in
		*/$DIRNAME/*) file="./$p" ;;
		*/$DIRNAME)   file="./$c/$p" ;;
		*)            fatal "must be run from the $DIRNAME directory" ;;
	esac

	gcc -O -Wall -W -pedantic -ansi -std=c99 -o "$file" "$file.c" && "$file"

	rm -f "$file"
}

main "$@"
